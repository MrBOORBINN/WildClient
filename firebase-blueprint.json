{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "createdAt": { "type": "timestamp", "description": "Account creation time" }
      },
      "required": ["uid", "email"]
    },
    "Session": {
      "title": "Session",
      "description": "A chat session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Session title" },
        "createdAt": { "type": "timestamp", "description": "Creation time" },
        "updatedAt": { "type": "timestamp", "description": "Last update time" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message within a session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Parent session ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "description": "Message content" },
        "timestamp": { "type": "number", "description": "Message timestamp" },
        "reaction": { "type": "string", "description": "User reaction / feedback", "enum": ["thumbs_up", "thumbs_down", "heart"] }
      },
      "required": ["sessionId", "userId", "role", "content", "timestamp"]
    },
    "NotebookSnippet": {
      "title": "NotebookSnippet",
      "description": "A highlighted snippet saved to personal notebook",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "text": { "type": "string", "description": "Snippet content" },
        "note": { "type": "string", "description": "Personal notes on snippet" },
        "color": { "type": "string", "description": "Highlight color code" },
        "tag": { "type": "string", "description": "Category or tag" },
        "messageId": { "type": "string", "description": "Source message ID" },
        "sessionId": { "type": "string", "description": "Source session ID" },
        "sessionTitle": { "type": "string", "description": "Source session title" },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["userId", "text", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "A long-term account-based memory record",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "Immutable owner UID" },
        "memory": { "type": "string", "description": "The concise factual memory content", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["preference", "project", "skill", "workflow", "other"] },
        "importance": { "type": "number", "description": "Importance score 0 to 100" },
        "confidence": { "type": "number", "description": "Confidence score 0 to 100" },
        "source": { "type": "string", "description": "Source of memory" },
        "created_at": { "type": "string", "description": "ISO timestamp string of creation" },
        "updated_at": { "type": "string", "description": "ISO timestamp string of last update" }
      },
      "required": ["user_id", "memory", "category", "importance", "confidence"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "sessions/{sessionId}": {
      "schema": "Session",
      "description": "User chat sessions"
    },
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages"
    },
    "notebook/{snippetId}": {
      "schema": "NotebookSnippet",
      "description": "User personal notebook snippets"
    },
    "memories/{memoryId}": {
      "schema": "Memory",
      "description": "User account-isolated long-term memories"
    }
  }
}
