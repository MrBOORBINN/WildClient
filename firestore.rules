rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: sessions
    // Document ID: {sessionId}
    // Fields:
    //   - userId: string (required)
    //   - title: string (required)
    //   - createdAt: timestamp (required)
    //   - updatedAt: timestamp (required)
    //
    // Collection: sessions/{sessionId}/messages
    // Document ID: {messageId}
    // Fields:
    //   - role: string (required, 'user' or 'assistant')
    //   - content: string (required)
    //   - timestamp: number (required)
    //   - attachments: list (optional)
    //
    // Collection: feedback
    // Document ID: {feedbackId}
    // Fields:
    //   - userId: string (required)
    //   - message: string (required)
    //   - timestamp: timestamp (required)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // --- Domain Validators ---
    function isValidUser() {
      return hasRequiredFields(['uid', 'email']) &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.email is string;
    }

    function isValidSession() {
      return (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('user_id', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == 'guest'
      );
    }

    function isValidMessage() {
      return hasRequiredFields(['role', 'content']) &&
             request.resource.data.role in ['user', 'assistant'] &&
             request.resource.data.content is string &&
             request.resource.data.content.size() <= 100000;
    }

    function isValidFeedback() {
      return request.resource.data.get('userId', '') == request.auth.uid;
    }

    function isValidMemory() {
      return (hasRequiredFields(['user_id', 'memory']) || hasRequiredFields(['userId', 'memory'])) &&
             (request.resource.data.get('user_id', '') == request.auth.uid || request.resource.data.get('userId', '') == request.auth.uid) &&
             request.resource.data.memory is string &&
             request.resource.data.memory.size() <= 1000;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId) && 
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('credits' in request.resource.data) || request.resource.data.credits == resource.data.get('credits', 70));
      allow delete: if isOwner(userId);
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('userId', '') == 'guest' ||
        (!('userId' in resource.data) && !('user_id' in resource.data))
      );
      allow create: if isAuthenticated() && isValidSession();
      allow update: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('userId', '') == 'guest' ||
        (!('userId' in resource.data) && !('user_id' in resource.data))
      );
      allow delete: if isAuthenticated() && (
        resource == null ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('userId', '') == 'guest' ||
        (!('userId' in resource.data) && !('user_id' in resource.data))
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('user_id', '') == request.auth.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', '') == 'guest'
        );
      }
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && isValidFeedback();
      allow read: if isAuthenticated();
    }

    match /notebook/{snippetId} {
      allow read: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('user_id', '') == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.get('userId', '') == request.auth.uid || request.resource.data.get('user_id', '') == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('user_id', '') == request.auth.uid);
      allow delete: if isAuthenticated() && (resource == null || resource.data.get('userId', '') == request.auth.uid || resource.data.get('user_id', '') == request.auth.uid);
    }

    match /memories/{memoryId} {
      allow read: if isAuthenticated() && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        (!('user_id' in resource.data) && !('userId' in resource.data))
      );
      allow create: if isAuthenticated() && isValidMemory();
      allow update: if isAuthenticated() && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource == null ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        (!('user_id' in resource.data) && !('userId' in resource.data))
      );
    }
  }
}
